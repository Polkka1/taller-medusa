STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Supabase Postgres via the Session pooler (port 5432).
# Supabase dashboard > Connect > Session pooler. Replace the placeholders.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

# REDIS_URL is intentionally not set: Medusa falls back to in-memory
# event bus, cache and locking for local development.
